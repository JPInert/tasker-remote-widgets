# Copy to kw.env (git-ignored) and fill in. Load it before running the Python tools:
#   set -a; . ./kw.env; set +a
#
# A long random string. It is in every file name on the host and is the ONLY thing stopping a
# stranger from reading or guessing your widget config. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
KW_TOKEN=
# Public HTTPS URL of the folder the files are served from (ending in /)
KW_PUB_URL=https://example.com/pub/
# ssh host alias that can write into that folder, and the folder's path on that host
KW_PUB_HOST=webhost
KW_PUB_DIR=/srv/www/pub
# publish.sh only: the JSON file holding the car's last reading, and the word arched on the face
KW_CAR_JSON=~/.cache/car/last-charge.json
KW_LABEL=CAR
# kw-kick.sh only (optional): ssh host alias for the phone (Termux sshd)
KW_PHONE_HOST=phone
